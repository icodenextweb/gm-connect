---
import BaseLayout from "../layouts/Wrapper.astro";
import { createClient } from "@sanity/client";
import imageUrlBuilder from '@sanity/image-url';

const client = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_STUDIO_PROJECT_ID,
  dataset: "production",
  useCdn: false,
  apiVersion: "2024-04-27",
});

const builder = imageUrlBuilder(client);
function urlFor(source: any) {
  return builder.image(source);
}

const query = `*[_type == "service"] | order(publishedAt desc) {
  title,
  description,
  icon,
  mainImage,
  "slug": slug.current
}`;

const services = await client.fetch(query);
---

<BaseLayout title="Engineering Solutions | GM-Connect">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <main class="bg-[#0F172A] min-h-screen py-24 px-6 overflow-hidden relative">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#10B981]/5 blur-[120px] -z-10"></div>
    
    <header class="max-w-7xl mx-auto mb-24 relative">
      <div class="inline-flex items-center gap-3 px-3 py-1 rounded-full border border-[#10B981]/20 bg-[#10B981]/5 mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10B981]"></span>
        </span>
        <span class="text-[#10B981] font-bold uppercase tracking-[0.3em] text-[10px]">System Modules</span>
      </div>
      <h1 class="text-6xl md:text-8xl font-black text-white tracking-tighter mb-8">
        Precision <span class="text-transparent bg-clip-text bg-gradient-to-b from-white to-gray-500">Engineering.</span>
      </h1>
    </header>

    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service: any, index: number) => (
        <a 
          href={`/services/${service.slug}`} 
          class="group relative bg-[#161e31]/40 backdrop-blur-md border border-white/5 rounded-xl overflow-hidden transition-all duration-700 hover:border-[#10B981]/40 hover:shadow-[0_0_40px_rgba(16,185,129,0.1)] reveal-anim"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="aspect-[16/9] overflow-hidden relative">
            <img 
              src={urlFor(service.mainImage).width(800).url()} 
              alt={service.mainImage.alt} 
              class="w-full h-full object-cover transition-all duration-1000 scale-110 group-hover:scale-100 grayscale-[50%] group-hover:grayscale-0"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A] via-transparent to-transparent opacity-80"></div>
          </div>
          
          <div class="p-8 relative">
            <div class="absolute -top-10 right-8 w-16 h-16 bg-[#10B981] flex items-center justify-center rounded-xl shadow-2xl transition-transform duration-500 group-hover:-translate-y-2">
              <i class={`${service.icon || 'fa-solid fa-layer-group'} text-[#0F172A] text-2xl`}></i>
            </div>

            <h2 class="text-2xl font-bold text-white mb-4 group-hover:text-[#10B981] transition-colors">
                {service.title}
            </h2>
            <p class="text-gray-400 text-sm leading-relaxed mb-8 line-clamp-2">
              {service.description}
            </p>
            
            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-[#10B981]">
              <span class="w-0 group-hover:w-8 h-px bg-[#10B981] transition-all duration-500"></span>
              Inspect Component
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes reveal {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .reveal-anim {
    animation: reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>