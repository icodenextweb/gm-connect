---
// GM-Connect: Professional Networking & Solutions Landing Page
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GM Connect | Seamless Integration</title>
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans scroll-smooth">

    <!-- Navbar -->
    <nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
              <span class="text-white font-bold">GM</span>
            </div>
            <span class="text-xl font-bold tracking-tight">Connect</span>
          </div>
          <div class="hidden md:flex space-x-8 font-medium">
            <a href="#services" class="hover:text-indigo-600 transition">Services</a>
            <a href="#why-us" class="hover:text-indigo-600 transition">Why Us</a>
            <a href="#faq" class="hover:text-indigo-600 transition">FAQ</a>
            <a href="#contact" class="px-4 py-2 bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition">Get Started</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <header class="pt-32 pb-20 lg:pt-48 lg:pb-32 bg-gradient-to-br from-slate-50 to-indigo-50">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h1 class="text-5xl lg:text-7xl font-extrabold text-slate-900 mb-6 leading-tight">
          Bridge the Gap Between <br/> <span class="text-indigo-600">Ideas & Execution.</span>
        </h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-10">
          GM Connect provides the infrastructure, network, and tools necessary to scale your business operations globally without the friction.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button class="px-8 py-4 bg-indigo-600 text-white rounded-xl font-bold shadow-lg shadow-indigo-200 hover:scale-105 transition">Start Connecting</button>
          <button class="px-8 py-4 bg-white border border-slate-200 rounded-xl font-bold hover:bg-slate-50 transition">View Demo</button>
        </div>
      </div>
    </header>

    <!-- Services Section -->
    <section id="services" class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Our Core Services</h2>
          <div class="h-1 w-20 bg-indigo-600 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { title: "Cloud Integration", desc: "Sync your entire workflow across multi-cloud environments seamlessly." },
            { title: "Network Security", desc: "Enterprise-grade encryption and threat detection for every node." },
            { title: "Data Analytics", desc: "Real-time insights to help you make data-driven decisions instantly." }
          ].map((service) => (
            <div class="p-8 rounded-2xl border border-slate-100 bg-slate-50 hover:shadow-xl transition group">
              <div class="w-12 h-12 bg-indigo-100 rounded-lg mb-6 group-hover:bg-indigo-600 transition-colors"></div>
              <h3 class="text-xl font-bold mb-3">{service.title}</h3>
              <p class="text-slate-600">{service.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section id="why-us" class="py-24 bg-slate-900 text-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl font-bold mb-8">Why Businesses Trust GM Connect</h2>
          <ul class="space-y-6">
            <li class="flex gap-4">
              <div class="text-indigo-400 font-bold text-xl">01.</div>
              <div>
                <h4 class="font-bold text-lg">99.9% Uptime Guarantee</h4>
                <p class="text-slate-400">Our redundant systems ensure your business never sleeps.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="text-indigo-400 font-bold text-xl">02.</div>
              <div>
                <h4 class="font-bold text-lg">Global Scalability</h4>
                <p class="text-slate-400">Deploy resources in over 40 regions worldwide in seconds.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="text-indigo-400 font-bold text-xl">03.</div>
              <div>
                <h4 class="font-bold text-lg">24/7 Expert Support</h4>
                <p class="text-slate-400">Real humans, real expertise, available whenever you need us.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="relative">
          <div class="aspect-square bg-indigo-600/20 rounded-3xl border border-indigo-500/30 flex items-center justify-center">
            <span class="text-indigo-400 italic">Visual Graphic Placeholder</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-24 bg-white">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group p-6 border border-slate-200 rounded-xl [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center cursor-pointer">
              <h3 class="font-bold">How long does integration take?</h3>
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-slate-600">Most clients are fully integrated and operational within 48 to 72 hours, depending on the complexity of existing legacy systems.</p>
          </details>
          <details class="group p-6 border border-slate-200 rounded-xl [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center cursor-pointer">
              <h3 class="font-bold">Is there a contract required?</h3>
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-slate-600">We offer both monthly flexible plans and annual discounted contracts to suit your specific budget needs.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- Contact Card -->
    <section id="contact" class="py-12">
      <div class="max-w-5xl mx-auto px-4">
        <div class="bg-indigo-600 rounded-3xl p-12 text-center text-white relative overflow-hidden shadow-2xl">
          <div class="relative z-10">
            <h2 class="text-4xl font-bold mb-4">Ready to transform your network?</h2>
            <p class="text-indigo-100 mb-8 text-lg">Join 500+ companies using GM Connect today.</p>
            <form class="flex flex-col md:flex-row gap-4 max-w-md mx-auto">
              <input type="email" placeholder="Enter your email" class="flex-1 px-6 py-4 rounded-xl text-slate-900 focus:outline-none" />
              <button class="px-8 py-4 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition">Get Started</button>
            </form>
          </div>
          <!-- Decorative circle -->
          <div class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500 rounded-full opacity-50"></div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-50 border-t border-slate-200 pt-16 pb-8">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-4 gap-12 mb-12">
          <div class="col-span-1 md:col-span-1">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-6 h-6 bg-indigo-600 rounded flex items-center justify-center text-[10px] text-white font-bold">GM</div>
              <span class="font-bold text-lg">Connect</span>
            </div>
            <p class="text-slate-500 text-sm">Empowering global enterprises with next-generation connectivity solutions since 2021.</p>
          </div>
          <div>
            <h4 class="font-bold mb-4">Product</h4>
            <ul class="text-slate-500 space-y-2 text-sm">
              <li><a href="#" class="hover:text-indigo-600">Features</a></li>
              <li><a href="#" class="hover:text-indigo-600">Integrations</a></li>
              <li><a href="#" class="hover:text-indigo-600">Pricing</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-4">Company</h4>
            <ul class="text-slate-500 space-y-2 text-sm">
              <li><a href="#" class="hover:text-indigo-600">About Us</a></li>
              <li><a href="#" class="hover:text-indigo-600">Careers</a></li>
              <li><a href="#" class="hover:text-indigo-600">Blog</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-4">Support</h4>
            <ul class="text-slate-500 space-y-2 text-sm">
              <li><a href="#" class="hover:text-indigo-600">Help Center</a></li>
              <li><a href="#" class="hover:text-indigo-600">API Docs</a></li>
              <li><a href="#" class="hover:text-indigo-600">Security</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-200 pt-8 text-center text-slate-400 text-sm">
          <p>&copy; 2026 GM Connect Inc. All rights reserved.</p>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }
  /* Custom scrollbar for better aesthetics */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f5f9;
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #6366f1;
  }
</style>