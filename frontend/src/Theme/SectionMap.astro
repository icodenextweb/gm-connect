---
import { sanityClient } from "sanity:client";
import Wrapper from "../layouts/Wrapper.astro";

export const prerender = false;

// --- MAP LOGIC ---
const mapData = await sanityClient.fetch(`*[_type == "mapSettings"][0]`);
const { iframeCode, locationName } = mapData || {}; 

const cleanIframe = iframeCode
  ? iframeCode.replace(/width="[^"]*"/, 'width="100%"').replace(/height="[^"]*"/, 'height="100%"')
  : null;

const mapStyles = {
  container: "flex-1 w-full font-sans",
  heading: "text-3xl font-black mb-6 text-white tracking-tighter flex items-center gap-3",
  mapWrapper: `
    relative w-full max-w-[400px] h-[400px]  
    rounded-sm overflow-hidden shadow-[0_0_15px_rgba(16,185,129,0.2)] 
    border border-white/5 bg-[#0F172A]
    leading-[0] opacity-0 transition-opacity duration-1000
  `,
  iframeWrapper: "[&_iframe]:w-full [&_iframe]:h-full [&_iframe]:border-0",
  errorBox: "p-6 bg-[#0F172A] text-[#10B981] rounded-sm border border-[#10B981]/20 shadow-sm",
  footerText: "mt-6 text-gray-400 text-[11px] font-bold uppercase tracking-widest"
};

// --- CONTACT FORM LOGIC ---
let status = "";
if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const response = await fetch(import.meta.env.FORMSPREE_URL, {
      method: "POST",
      body: data,
      headers: { 'Accept': 'application/json' }
    });
    if (response.ok) status = "success";
    else status = "error";
  } catch (e) {
    status = "error";
  }
}

const theme = {
  pageBg: "bg-[#0F172A]", 
  glass: "bg-[#161e31]/60 backdrop-blur-3xl border border-white/5 shadow-[0_20px_50px_rgba(0,0,0,0.5)]",
  input: "bg-[#0F172A]/50 border-white/10 text-white focus:bg-[#0F172A] focus:border-[#10B981]/50 focus:ring-4 focus:ring-[#10B981]/5 transition-all duration-300",
  accent: "bg-[#10B981] hover:bg-[#059669] text-[#0F172A] shadow-[0_0_20px_rgba(16,185,129,0.2)]"
};
---

<Wrapper>
  <style>
    @import "tailwindcss";
    
    .form-slider {
      display: flex;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      width: 300%;
    }
    
    .step-slide {
      width: 33.333%;
      flex-shrink: 0;
    }

    /* Emerald glow blobs */
    .blob {
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.07) 0%, transparent 70%);
      filter: blur(80px);
      z-index: -1;
    }

    /* Ensuring the text colors align with the dark theme */
    :global(body) {
      background-color: #0F172A;
    }
  </style>

  <main id = "contact" class={`min-h-screen flex items-center justify-center p-6 lg:p-12 relative overflow-hidden ${theme.pageBg}`}>
    
    <div class="blob -top-48 -left-48 animate-pulse"></div>
    <div class="blob -bottom-48 -right-48 animate-pulse" style="animation-delay: 3s;"></div>

    <div class="w-full max-w-7xl flex flex-col lg:flex-row items-center lg:items-start gap-16 relative z-10">
      
      <div class={mapStyles.container}>
        <h1 class={mapStyles.heading}>
          <div class="flex items-center gap-1">
              <span class="w-1.5 h-6 bg-[#1E40AF]"></span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#10B981]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
          </div>
          {locationName || "Find Us"} 
        </h1>

        {cleanIframe ? (
          <div 
            id="map-container"
            class={`${mapStyles.mapWrapper} ${mapStyles.iframeWrapper}`} 
            set:html={cleanIframe} 
          />
        ) : (
          <div class={mapStyles.errorBox}>
            <p><span class="font-bold uppercase tracking-tighter">Setup Required:</span> Please add the Google Maps iframe code in Sanity Studio.</p>
          </div>
        )}
        
        <p class={mapStyles.footerText}>
          Visit us during office hours: 9:00 AM — 6:00 PM
        </p>
      </div>

      <div class={`w-full max-w-xl rounded-sm ${theme.glass} overflow-hidden relative border border-white/10`}>
        
        <div class="h-1 w-full bg-white/5">
          <div id="progress-bar" class="h-full bg-[#10B981] transition-all duration-700 w-1/3 shadow-[0_0_10px_#10B981]"></div>
        </div>

        <div class="p-10 md:p-16">
          <header class="mb-14">
            <div class="flex items-center gap-2 mb-4">
               <span class="w-8 h-px bg-[#10B981]"></span>
               <p class="text-[#10B981] text-[10px] font-bold uppercase tracking-[0.3em]">Project Initiation</p>
            </div>
            <h2 class="text-4xl font-black text-white tracking-tighter uppercase italic">Secure Inquiry</h2>
          </header>

          {status === "success" ? (
            <div class="text-center py-16 animate-in fade-in zoom-in duration-700">
              <div class="w-20 h-20 bg-[#10B981]/10 border border-[#10B981]/20 rounded-full flex items-center justify-center mx-auto mb-8">
                <svg class="w-10 h-10 text-[#10B981]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white uppercase tracking-tight">Transmission Complete</h3>
              <p class="text-gray-400 mt-3 text-sm tracking-wide">Our engineering team will review your specs shortly.</p>
              <a href="/" class="mt-10 inline-block text-[#10B981] text-xs font-bold uppercase tracking-widest border-b border-[#10B981]/30 pb-1">Return to Dashboard</a>
            </div>
          ) : (
            <form id="sliding-form" method="POST" class="overflow-hidden">
              <div id="form-track" class="form-slider">
                
                <div class="step-slide pr-10">
                  <div class="space-y-8">
                    <div class="group">
                      <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em] mb-4 ml-1 transition-colors group-focus-within:text-[#10B981]">Identity & Contact</label>
                      <input type="text" name="name" placeholder="FULL NAME" required class={`w-full px-8 py-5 rounded-sm outline-none placeholder:text-gray-600 font-bold text-xs tracking-widest border ${theme.input}`} />
                    </div>
                    <input type="email" name="email" placeholder="EMAIL ADDRESS" required class={`w-full px-8 py-5 rounded-sm outline-none placeholder:text-gray-600 font-bold text-xs tracking-widest border ${theme.input}`} />
                  </div>
                </div>

                <div class="step-slide px-5">
                  <div class="space-y-8">
                    <div>
                      <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em] mb-4 ml-1">Classification</label>
                      <div class="relative">
                        <select name="type" class={`w-full px-8 py-5 rounded-sm outline-none appearance-none cursor-pointer font-bold text-xs tracking-widest border ${theme.input}`}>
                          <option>PLC AUTOMATION</option>
                          <option>ROBOTICS & COBOTS</option>
                          <option>MACHINE RETROFITTING</option>
                          <option>INDUSTRY 4.0 INTEGRATION</option>
                        </select>
                        <div class="absolute right-8 top-1/2 -translate-y-1/2 pointer-events-none text-[#10B981]">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        </div>
                      </div>
                    </div>
                    <input type="text" name="timeline" placeholder="EXPECTED TIMELINE" class={`w-full px-8 py-5 rounded-sm outline-none placeholder:text-gray-600 font-bold text-xs tracking-widest border ${theme.input}`} />
                  </div>
                </div>

                <div class="step-slide pl-10">
                  <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em] mb-4 ml-1">Project Specification</label>
                    <textarea name="message" rows="4" placeholder="BRIEF DESCRIPTION OF THE MODULE REQUIREMENTS..." required class={`w-full px-8 py-5 rounded-sm outline-none resize-none placeholder:text-gray-600 font-bold text-xs tracking-widest leading-loose border ${theme.input}`}></textarea>
                  </div>
                </div>
              </div>

              <div class="mt-16 flex items-center justify-between gap-6">
                <button type="button" id="back-btn" class="invisible text-gray-500 text-[10px] font-black uppercase tracking-[0.2em] hover:text-white transition-colors px-4 cursor-pointer">
                  Back
                </button>
                <button type="button" id="next-btn" class={`flex-1 py-5 rounded-sm font-black text-[11px] tracking-[0.2em] uppercase transition-all active:scale-[0.98] cursor-pointer ${theme.accent}`}>
                  Continue →
                </button>
                <button type="submit" id="submit-btn" class={`hidden flex-1 py-5 rounded-sm font-black text-[11px] tracking-[0.2em] uppercase transition-all active:scale-[0.98] cursor-pointer ${theme.accent}`}>
                  Deploy Message
                </button>
              </div>
            </form>
          )}
        </div>
        <div class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-br from-transparent to-[#10B981]/5 -z-10"></div>
      </div>

    </div>
  </main>
</Wrapper>

<script is:inline>
  // Fade-in animation for map
  const initMapFade = () => {
    const map = document.getElementById('map-container');
    if (map) {
      setTimeout(() => {
        map.classList.remove('opacity-0');
        map.classList.add('opacity-100');
      }, 200);
    }
  };

  // Multi-step form logic
  let currentStep = 1;
  const totalSteps = 3;

  const track = document.getElementById('form-track');
  const nextBtn = document.getElementById('next-btn');
  const backBtn = document.getElementById('back-btn');
  const submitBtn = document.getElementById('submit-btn');
  const progressBar = document.getElementById('progress-bar');

  function updateSlide() {
    if (!track) return;
    const offset = (currentStep - 1) * -33.333;
    track.style.transform = `translateX(${offset}%)`;
    
    if (progressBar) {
      const progressWidth = (currentStep / totalSteps) * 100;
      progressBar.style.width = `${progressWidth}%`;
    }

    if (backBtn) {
      backBtn.style.visibility = currentStep === 1 ? 'hidden' : 'visible';
    }
    
    if (nextBtn && submitBtn) {
      if (currentStep === totalSteps) {
        nextBtn.classList.add('hidden');
        submitBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        submitBtn.classList.add('hidden');
      }
    }
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      const currentSlide = track.children[currentStep - 1];
      const inputs = currentSlide.querySelectorAll('input, select, textarea');
      let allValid = true;
      
      inputs.forEach(input => {
        if (input.hasAttribute('required') && !input.value) {
          allValid = false;
          input.classList.add('border-red-900/50');
          input.classList.add('bg-red-950/10');
        } else {
          input.classList.remove('border-red-900/50');
          input.classList.remove('bg-red-950/10');
        }
      });

      if (allValid && currentStep < totalSteps) {
        currentStep++;
        updateSlide();
      }
    });
  }

  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateSlide();
      }
    });
  }

  // Lifecycle execution
  window.addEventListener('load', () => {
    initMapFade();
    updateSlide();
  });
  
  // Support for Astro transitions
  document.addEventListener('astro:after-swap', () => {
    initMapFade();
    updateSlide();
  });
</script>