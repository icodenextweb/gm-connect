---
/**
 * GM-Connect "Why Choose Us" Enhanced Section
 * Palette: Emerald (#10B981) & Deep Sea Blue (#0F172A)
 * Design: Industrial Grid with High-Contrast Accents
 */

const features = [
  {
    title: "Experienced Technical Team",
    description: "Our success is driven by seasoned senior experts with vast experience in design, production, and installation across India and abroad.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    size: "lg:col-span-2"
  },
  {
    title: "Tailor-Made Solutions",
    description: "Bespoke technical designs customized for unique processes, specializing in Micro Controller-Based systems and PLC programming.",
    icon: "M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z",
    size: "lg:col-span-1"
  },
  {
    title: "Strong After-Sales Support",
    description: "A long-term commitment with dedicated technicians ensuring continuous, smooth operation and minimal production disruption.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    size: "lg:col-span-1"
  },
  {
    title: "Cost-Effective & Timely",
    description: "Optimized processes that minimize waste to ensure projects are delivered within the agreed-upon budget and strict deadlines.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    size: "lg:col-span-1"
  },
  {
    title: "Quality & Safety Standards",
    description: "Built-in compliance with national and international industrial safety standards, including fail-safe designs for asset protection.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    size: "lg:col-span-1"
  }
];
---

<section class="relative bg-[#0F172A] py-24 overflow-hidden border-t border-white/5">
  <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-[#10B981] blur-[150px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[30%] h-[30%] rounded-full bg-[#1E40AF] blur-[120px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20 reveal-item">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-[1px] bg-[#10B981]"></div>
          <span class="text-[#10B981] font-mono font-bold uppercase tracking-[0.4em] text-[10px]">Division: Excellence</span>
        </div>
        <h2 class="text-6xl md:text-7xl font-black text-white leading-[0.85] uppercase tracking-tighter">
          Engineering <br/> 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-emerald-400 to-emerald-200">
            Excellence.
          </span>
        </h2>
      </div>
      <div class="max-w-xs space-y-4">
        <p class="text-gray-400 text-sm border-l-2 border-[#10B981] pl-6 py-2 leading-relaxed">
          Defining the quality of execution through technical mastery and proactive industrial support protocols.
        </p>
        <div class="text-[10px] font-mono text-white/20 uppercase tracking-widest pl-7">
          Protocol: V4.02_STABLE
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <div 
          class={`group relative bg-[#1e293b]/30 border-b border-l border-white/5 p-10 transition-all duration-500 hover:bg-[#10B981]/5 hover:border-[#10B981]/40 ${feature.size} reveal-item overflow-hidden`} 
          style={`transition-delay: ${index * 150}ms`}
        >
          {/* Top and Right Borders - Shape Preserved */}
          <div class="absolute top-0 left-0 w-full h-[1px] bg-white/5 group-hover:bg-[#10B981]/40 transition-colors duration-500"></div>
          <div class="absolute top-0 right-0 h-full w-[1px] bg-white/5 group-hover:bg-[#10B981]/40 transition-colors duration-500"></div>

          {/* Industrial Bevel Corner Accent */}
          <div class="absolute top-0 right-0 w-12 h-12 border-t-[3px] border-r-[3px] border-[#1E40AF] z-20 transition-all duration-500 group-hover:w-16 group-hover:h-16"></div>
          <div class="absolute top-0 right-0 w-4 h-4 bg-[#1E40AF] z-20"></div>

          <div class="flex flex-col h-full relative z-10">
            <div class="mb-12 flex items-center justify-between">
              <div class="p-4 bg-[#10B981]/10 text-[#10B981] group-hover:bg-[#10B981] group-hover:text-[#0F172A] transition-all duration-500 rounded-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d={feature.icon}></path>
                </svg>
              </div>
              <span class="text-white/5 font-mono font-black text-6xl group-hover:text-[#10B981]/10 transition-colors duration-500">
                0{index + 1}
              </span>
            </div>

            <h3 class="text-2xl font-bold text-white uppercase tracking-tight mb-4 group-hover:translate-x-2 transition-transform duration-500">
              {feature.title}
            </h3>
            
            <p class="text-gray-400 text-sm leading-relaxed mb-10 flex-grow group-hover:text-gray-300 transition-colors">
              {feature.description}
            </p>

            <div class="flex items-center gap-3">
               <div class="h-[1px] w-8 bg-[#10B981] scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500"></div>
               <span class="text-[#10B981] text-[10px] font-mono font-bold uppercase tracking-[0.2em] opacity-0 group-hover:opacity-100 transition-all duration-500 translate-x-[-10px] group-hover:translate-x-0">
                System_Active
              </span>
            </div>
          </div>

          <div class="absolute inset-0 opacity-0 group-hover:opacity-5 transition-opacity duration-700 pointer-events-none bg-[radial-gradient(#10B981_1px,transparent_1px)] [background-size:20px_20px]"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .reveal-item {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .reveal-item.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observerOptions = { 
    threshold: 0.15,
    rootMargin: "0px 0px -50px 0px"
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, observerOptions);

  const initReveal = () => {
    document.querySelectorAll('.reveal-item').forEach(el => observer.observe(el));
  };

  initReveal();
  document.addEventListener('astro:after-swap', initReveal);
</script>