---
interface Props {
  title?: string;
  description?: string;
  address?: string;
  phone?: string;
  email?: string;
}

const {
  title = "Our Story",
  description = "During our journey in the industrial field, GM Engineering & Robotics has proudly catered to the industrial automation sectors. We have established ourselves as a trusted engineering solutions partner committed to bringing unmatched quality, discipline, and technological innovation to the field.",
  address = "GM Engineering and Robotics 1266/12, Plot No.4, Anukamini Colony Rankala Tower, Behind Excise Office, Dudhali, Kolhapur - 412 012",
  phone = "+91 8329548026",
  email = "info.gmenr@gmail.com"
} = Astro.props;
---

<section id="story" class="min-h-screen bg-[#0F172A] text-white flex items-center justify-center py-24 px-6 relative overflow-hidden">
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#1E40AF]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-[#10B981]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center z-10">
    
    <div class="lg:col-span-7 space-y-6">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-8 bg-[#10B981]"></span>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">{title}</h1>
      </div>
      <p class="text-gray-300 text-lg leading-relaxed font-light max-w-2xl">
        {description}
      </p>
    </div>

    <div class="lg:col-span-5 bg-[#11192E] border border-white/5 p-8 rounded-sm shadow-2xl relative group">
      <div class="absolute top-0 left-0 w-full h-[2px] bg-[#10B981] transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
      
      <h2 class="text-xs font-bold uppercase tracking-widest text-[#10B981] mb-8">
        Corporate Directory
      </h2>

      <div class="space-y-6">
        <div class="flex gap-4 items-start">
          <div class="p-2 bg-[#1E40AF]/20 text-[#10B981] rounded-sm mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Headquarters</h4>
            <p class="text-gray-200 text-sm leading-relaxed">{address}</p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="p-2 bg-[#1E40AF]/20 text-[#10B981] rounded-sm mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Direct Line</h4>
            <a href={`tel:${phone}`} class="text-gray-200 text-sm font-bold tracking-wider hover:text-[#10B981] transition-colors">{phone}</a>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="p-2 bg-[#1E40AF]/20 text-[#10B981] rounded-sm mt-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">Digital Intake</h4>
            <a href={`mailto:${email}`} class="text-gray-200 text-sm font-bold tracking-wider hover:text-[#10B981] transition-colors">{email}</a>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-white/5">
        <a 
          href="#contact" 
          class="inline-flex items-center justify-center transition-all duration-300 ease-in-out rounded-sm font-bold uppercase tracking-wider bg-[#10B981] text-[#0F172A] hover:bg-[#059669] shadow-[0_0_15px_rgba(16,185,129,0.3)] px-5 py-3 text-[11px] w-full text-center"
        >
          Initiate Connection
        </a>
      </div>
    </div>

  </div>
</section>